# Development lokal
VITE_API_BASE_URL=http://localhost:4000/api

# Production Vercel
# Jika client/vercel.json memakai rewrite /api ke server Vercel,
# gunakan path satu-origin ini agar cookie login admin lebih stabil.
VITE_API_BASE_URL=/api

# Alternatif direct API, wajib cocok dengan CLIENT_ORIGIN di server:
# VITE_API_BASE_URL=https://surat-kerjasama-server.vercel.app/api
